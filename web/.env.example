# ===================================================
# FRONTEND ENVIRONMENT
# Copy to web/.env.local and fill in real values
# DO NOT commit web/.env.local to git
# ===================================================

# API URL (replace DOMAIN with your actual domain)
NEXT_PUBLIC_API_URL=https://DOMAIN/api
NEXTAUTH_URL=https://DOMAIN

# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=CHANGE_ME_RANDOM_64_HEX_CHARS

# Set automatically by infra/setup-zitadel.sh - do not change manually
ZITADEL_ISSUER=http://localhost:8080
ZITADEL_CLIENT_ID=
ZITADEL_CLIENT_SECRET=

# Google OAuth (same values as in infra/.env)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Zitadel Google IdP ID - set automatically by setup-zitadel.sh
NEXT_PUBLIC_ZITADEL_GOOGLE_IDP_ID=

# DEV only: bypass TLS cert validation for self-signed certs
# REMOVE THIS LINE for PRE and PRO environments
NODE_TLS_REJECT_UNAUTHORIZED=0
