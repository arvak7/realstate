# Caddyfile.dev - Development environment (mkcert certificates)
# Generated by start-all.sh via: envsubst < Caddyfile.dev > Caddyfile
# DO NOT edit Caddyfile directly - edit this template instead

{
    auto_https off
    admin off
}

# Redirect HTTP to HTTPS
http://${DOMAIN} {
    redir https://${DOMAIN}{uri} permanent
}

# Main HTTPS - all services through port 443
https://${DOMAIN} {
    tls /certs/localhost.pem /certs/localhost-key.pem

    # MinIO public file access (images, uploads)
    handle /files/* {
        uri strip_prefix /files
        reverse_proxy http://realstate-minio:9000 {
            header_up Host {host}
        }
    }

    # Zitadel IdP callbacks (Google OAuth etc.)
    handle /idps/* {
        reverse_proxy http://realstate-zitadel:8080 {
            header_up Host ${DOMAIN}
            header_up X-Forwarded-Proto https
        }
    }

    # Zitadel Login V2 UI
    handle /ui/v2/login/* {
        reverse_proxy realstate-zitadel-login:3000 {
            header_up Host ${DOMAIN}
            header_up X-Forwarded-Proto https
        }
        header -X-Frame-Options
        header -Content-Security-Policy
    }

    # NextAuth routes - must go to Next.js (not stripped)
    handle /api/auth/* {
        reverse_proxy http://host.docker.internal:3000 {
            header_up Host {host}
            header_up X-Forwarded-Proto https
        }
    }

    # Backend API routes (strip /api prefix)
    handle_path /api/* {
        reverse_proxy http://host.docker.internal:3002 {
            header_up Host {host}
            header_up X-Forwarded-Proto https
        }
    }

    # Frontend - everything else
    handle {
        reverse_proxy http://host.docker.internal:3000 {
            header_up Host {host}
            header_up X-Forwarded-Proto https
        }
    }
}

# Zitadel OIDC API direct access
https://${DOMAIN}:8443 {
    tls /certs/localhost.pem /certs/localhost-key.pem

    reverse_proxy http://realstate-zitadel:8080 {
        header_up Host {host}
        header_up X-Forwarded-Proto https
    }
}

# MinIO Console
https://${DOMAIN}:9001 {
    tls /certs/localhost.pem /certs/localhost-key.pem

    reverse_proxy http://realstate-minio:9001 {
        header_up Host {host}
        header_up X-Forwarded-Proto https
    }
}
