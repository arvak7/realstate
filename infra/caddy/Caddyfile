# Caddy Configuration for Real Estate
# HTTPS Reverse Proxy - everything through port 443

{
	# Global options (must be first)
	auto_https off
	admin off
}

# HTTP handler - redirect to HTTPS
http://localhost {
	redir https://localhost{uri} permanent
}

# Main HTTPS entry point - all services through port 443
https://localhost {
	tls /certs/localhost.pem /certs/localhost-key.pem

	# Zitadel IdP callbacks (Google OAuth, etc.) → Zitadel API
	handle /idps/* {
		reverse_proxy http://realstate-zitadel:8080 {
			header_up Host localhost
			header_up X-Forwarded-Proto https
		}
	}

	# Zitadel Login V2 UI → Login V2 container
	handle /ui/v2/login/* {
		reverse_proxy realstate-zitadel-login:3000 {
			header_up Host localhost
			header_up X-Forwarded-Proto https
		}
		header -X-Frame-Options
		header -Content-Security-Policy
	}

	# NextAuth routes → Next.js
	handle /api/auth/* {
		reverse_proxy http://host.docker.internal:3000 {
			header_up Host {host}
			header_up X-Forwarded-Proto https
		}
	}

	# Backend API routes → Express
	handle_path /api/* {
		reverse_proxy http://host.docker.internal:3002 {
			header_up Host {host}
			header_up X-Forwarded-Proto https
		}
	}

	# Everything else → Next.js frontend
	handle {
		reverse_proxy http://host.docker.internal:3000 {
			header_up Host {host}
			header_up X-Forwarded-Proto https
		}
	}
}

# Zitadel OIDC API - Port 8443
https://localhost:8443 {
	tls /certs/localhost.pem /certs/localhost-key.pem

	reverse_proxy http://realstate-zitadel:8080 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
	}
}

# MinIO Console - Port 9001
https://localhost:9001 {
	tls /certs/localhost.pem /certs/localhost-key.pem

	reverse_proxy http://realstate-minio:9001 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
	}
}
