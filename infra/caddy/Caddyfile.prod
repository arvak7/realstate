# Caddyfile.prod - Production/Staging environment (Let's Encrypt via Caddy ACME)
# Generated by deploy.sh via: envsubst < Caddyfile.prod > Caddyfile
# DO NOT edit Caddyfile directly - edit this template instead
# Requirements: port 80 must be publicly accessible for ACME HTTP-01 challenge

{
    # auto_https is ON by default - Caddy handles Let's Encrypt automatically
    admin off
    email admin@${DOMAIN}
}

# Caddy handles HTTP→HTTPS redirect automatically when auto_https is on

# Main HTTPS - all services through port 443
https://${DOMAIN} {
    # No tls directive - Caddy auto-provisions Let's Encrypt cert

    # Zitadel IdP callbacks (Google OAuth etc.)
    handle /idps/* {
        reverse_proxy http://realstate-zitadel:8080 {
            header_up Host ${DOMAIN}
            header_up X-Forwarded-Proto https
        }
    }

    # Zitadel Login V2 UI
    handle /ui/v2/login/* {
        reverse_proxy realstate-zitadel-login:3000 {
            header_up Host ${DOMAIN}
            header_up X-Forwarded-Proto https
        }
        header -X-Frame-Options
        header -Content-Security-Policy
    }

    # NextAuth routes
    handle /api/auth/* {
        reverse_proxy http://realstate-nextjs:3000 {
            header_up Host {host}
            header_up X-Forwarded-Proto https
        }
    }

    # Backend API routes (strip /api prefix)
    handle_path /api/* {
        reverse_proxy http://realstate-backend:3002 {
            header_up Host {host}
            header_up X-Forwarded-Proto https
        }
    }

    # Frontend
    handle {
        reverse_proxy http://realstate-nextjs:3000 {
            header_up Host {host}
            header_up X-Forwarded-Proto https
        }
    }
}

# Zitadel OIDC API direct access (for token validation)
https://${DOMAIN}:8443 {
    reverse_proxy http://realstate-zitadel:8080 {
        header_up Host {host}
        header_up X-Forwarded-Proto https
    }
}
