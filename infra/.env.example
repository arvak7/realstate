# ===================================================
# ENVIRONMENT CONFIGURATION
# Copy to infra/.env and fill in real values
# DO NOT commit infra/.env to git
# ===================================================

# Environment: DEV | PRE | PRO
APP_ENV=DEV

# Domain (no trailing slash, no protocol)
# DEV:  localhost
# PRE:  staging.yourdomain.com
# PRO:  yourdomain.com
DOMAIN=localhost

# SSL mode: mkcert | letsencrypt
# DEV: mkcert (requires running infra/mkcert-setup.sh first)
# PRE/PRO: letsencrypt (Caddy handles Let's Encrypt automatically)
SSL_MODE=mkcert

# ===================================================
# PostgreSQL
# ===================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=realstate

# ===================================================
# MinIO (object storage)
# ===================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ===================================================
# Zitadel (identity provider)
# ===================================================
# Generate with: openssl rand -base64 32 | tr -d '=+/' | head -c 32
ZITADEL_MASTERKEY=CHANGE_ME_EXACTLY_32_BYTES_LONG_!!
ZITADEL_ADMIN_PASSWORD=Admin123!

# External domain settings (affects token issuer URL)
# DEV:  EXTERNALSECURE=false, EXTERNALPORT=8080
# PRO:  EXTERNALSECURE=true,  EXTERNALPORT=443
ZITADEL_EXTERNALSECURE=false
ZITADEL_EXTERNALPORT=8080

# Zitadel console port binding (security)
# DEV:     0.0.0.0   → accessible a http://localhost:8080 (ok en local)
# PRE/PRO: 127.0.0.1 → només accessible des del servidor (accés via SSH tunnel)
# Accés en PRO: ssh -L 8080:localhost:8080 user@servidor → http://localhost:8080
ZITADEL_BIND=0.0.0.0

# ===================================================
# Google OAuth (optional - enables Google login button)
# Register at: https://console.cloud.google.com/apis/credentials
# Redirect URIs to add: https://DOMAIN/api/auth/callback/google
#                       https://DOMAIN/idps/callback
# ===================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===================================================
# SMTP (required for PRO - enables email verification & password reset)
# ===================================================
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com
SMTP_FROM_NAME=Immobles
