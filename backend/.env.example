# ===================================================
# BACKEND ENVIRONMENT
# Copy to backend/.env and fill in real values
# DO NOT commit backend/.env to git
# ===================================================

# Database (update POSTGRES_PASSWORD to match infra/.env)
DATABASE_URL="postgresql://postgres:CHANGE_ME_STRONG_PASSWORD@localhost:5432/realstate?schema=public"

ELASTICSEARCH_NODE="http://localhost:9200"
REDIS_URL="redis://localhost:6379"

# MinIO (update MINIO_ROOT_PASSWORD to match infra/.env)
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="CHANGE_ME_STRONG_PASSWORD"
MINIO_USE_SSL=false

# Zitadel - set automatically by infra/setup-zitadel.sh
ZITADEL_ISSUER=http://localhost:8080
ZITADEL_AUDIENCE=

PORT=3002

# DEV only: bypass TLS cert validation for self-signed certs
# REMOVE THIS LINE for PRE and PRO environments
NODE_TLS_REJECT_UNAUTHORIZED=0
